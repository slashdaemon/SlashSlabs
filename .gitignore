# Gradle / build output
.gradle/
build/
versions/*/build/
versions/*/.gradle/
out/

# Dev and test servers (worlds, configs, logs, downloaded jars)
versions/*/run/
run/

# IDEs and OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

